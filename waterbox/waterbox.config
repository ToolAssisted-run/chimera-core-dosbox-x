        "videoMemoryMB": -1,
        "vesaModelistWidthLimit": 1280,
        "vesaModelistHeightLimit": 1024,
        "dosVersion": "auto",
        "hardDriveDataRateLimit": -1,
        "floppyDriveDataRateLimit": -1,
        "int13FakeIo": false,
        "cdromInsertionDelayMs": 0,
        "cpuCore": "normal",
        "cpuType": "8086",
        "cpuCycles": 315,
        "soundBlasterModel": "none",
        "videoCardType": "mda",
        "memsizeMB": 0
