      },
      "sha1": "78BA9960F135372825AB7244B5E4E73A810002FF"
    },
    {
      "id": "SOUND.ROM",
      "display": "PC-98 sound BIOS",
      "description": "The 16 KiB BIOS of a PC-9801-26K or -86 sound board you own.",
      "size": 16384,
      "name": "SOUND.ROM",
      "label": "NEC PC-9801-26K/86 SOUND.ROM",
