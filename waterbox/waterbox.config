      "display": "Roland MT-32 PCM ROM",
      "description": "Dumped from a Roland unit you own. The one PCM ROM every MT-32 has.",
      "size": 524288,
      "name": "MT32_PCM.ROM",
      "label": "MT-32 PCM",
      "requiredWhen": {
        "setting": "midiDevice",
        "in": [
          "mt32_old",
          "mt32_new"
        ]
      },
