{
  "coreName": "DOSBox-X",
  "systemId": "DOS",
  "systemNames": {
    "DOS": "MS-DOS"
  },
  "author": "DOSBox-X team; chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-dosbox-x",
  "romFile": "rom",
  "deterministic": true,
  "memoryLayoutMiB": [
    256,
    16,
    16,
    64,
    1024
  ],
  "video": {
    "_comment": "the BUFFER capacity (BizHawk's SVGA_MAX plane); the live size comes from GetVideoWidth/Height per frame",
    "width": 2560,
    "height": 2048,
    "virtualWidth": 1024,
    "virtualHeight": 768,
    "vsyncNumerator": 3146888,
    "vsyncDenominator": 44900,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "samplesPerFrame": 8192,
    "channels": 2,
    "get": "GetAudio"
  },
  "input": {
    "name": "DOSBox Controller",
    "_comment": "index order is the wire format, imported from BizHawk's controller definition: joysticks, mouse buttons, disk-swap controls, then the 102-key keyboard, listed as it sits on the keyboard (each key's KBD_KEYS value is in key-order.h, see gen-config.py). Wider than 64, so everything rides the SetButton channel.",
    "buttons": [
      "P1 Joystick Up",
      "P1 Joystick Down",
      "P1 Joystick Left",
      "P1 Joystick Right",
      "P1 Joystick Button 1",
      "P1 Joystick Button 2",
