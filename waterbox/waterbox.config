      "Key V",
      "Key B",
      "Key N",
      "Key M",
      "Key F1",
      "Key F2",
      "Key F3",
      "Key F4",
      "Key F5",
      "Key F6",
      "Key F7",
      "Key F8",
      "Key F9",
      "Key F10",
      "Key F11",
      "Key F12",
      "Key Escape",
      "Key Tab",
      "Key Backspace",
      "Key Enter",
      "Key Space",
      "Key LeftAlt",
      "Key RightAlt",
      "Key LeftCtrl",
      "Key RightCtrl",
      "Key LeftShift",
      "Key RightShift",
      "Key CapsLock",
      "Key ScrollLock",
      "Key NumLock",
      "Key Grave",
      "Key Minus",
      "Key Equals",
      "Key Backslash",
      "Key LeftBracket",
      "Key RightBracket",
      "Key Semicolon",
      "Key Quote",
