      "Key Comma",
      "Key Slash",
      "Key ExtraLtGt",
      "Key PrintScreen",
      "Key Pause",
      "Key Insert",
      "Key Home",
      "Key Pageup",
      "Key Delete",
      "Key End",
      "Key Pagedown",
      "Key Left",
      "Key Up",
      "Key Down",
      "Key Right",
      "Key KeyPad1",
      "Key KeyPad2",
      "Key KeyPad3",
      "Key KeyPad4",
      "Key KeyPad5",
      "Key KeyPad6",
      "Key KeyPad7",
