  'extern/dosbox-x/src/hardware/snd_pc98/common',
  'extern/dosbox-x/src/hardware/snd_pc98/x11',
  'extern/dosbox-x/src/hardware/snd_pc98/sound/getsnd',
  'extern/dosbox-x/src/hardware/snd_pc98/cbus',
)

