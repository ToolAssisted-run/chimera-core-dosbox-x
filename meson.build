# chimera-core-dosbox-x: DOSBox-X in miniBox's sandbox, as a Chimera core.
#
# Native reference build (bin under the build dir):
#     meson setup build/meson-native
#     ninja -C build/meson-native
# The guest (core.wbx) build adds a cross file for miniBox's musl toolchain
# (docs/PLAN.md, M3).
#
# The curated source list descends from the author's BizHawk
# waterbox/dosbox/Makefile, extended where upstream v2026.08.02 needs it
# (SDL_sound decoders, libchdr modules, new builtins). It compiles the
# SUBMODULE tree with patches/ overlaid onto it (full-file copies, re-run at
# every reconfigure), so quote-includes of patched headers resolve for
# unpatched sources too.
project('chimera-core-dosbox-x', ['c', 'cpp'],
  default_options: ['cpp_std=c++20', 'c_std=gnu11', 'optimization=2', 'debug=false', 'warning_level=0'])

# keep the overlay fresh on every (re)configure
run_command(files('waterbox/overlay-patches.sh'), check: true)

defs = [
  '-DNDEBUG',
  '-DSDL_BUILD_MAJOR_VERSION=2', '-DSDL_BUILD_MINOR_VERSION=32',
  '-DSDL_BUILD_MICRO_VERSION=0', '-DHAVE_LINUX_VERSION_H',
  '-DUSING_GENERATED_CONFIG_H', '-D__LINUX__', '-D__INLINE__=inline',
]
quiet = [
  '-fno-strict-aliasing', '-Wno-deprecated-declarations', '-Wno-write-strings',
  '-Wno-format-security',
]
add_project_arguments(defs + quiet, language: ['c', 'cpp'])

inc = include_directories(
  'waterbox',
  'extern/vendored/SDL2/include',
  'extern/vendored/SDL2/src',
  'extern/vendored/libco',
  'extern/jaffarCommon/include',
  'extern/dosbox-x',
  'extern/dosbox-x/include',
  'extern/dosbox-x/src',
  'extern/vendored/sdlnet',
  'extern/dosbox-x/src/hardware/snd_pc98/sound',
